# ==========================================
# FCN TI - Variaveis de Ambiente (Staging)
# ==========================================
# COPIE ESTE ARQUIVO PARA .env.staging NA VPS:
# cp .env.staging.example .env.staging
#
# NUNCA COMMITE O ARQUIVO .env.staging REAL NO GIT!

# Django
DEBUG=0
SECRET_KEY=gere-uma-chave-aleatoria-segura-aqui-com-pelo-menos-50-caracteres
ALLOWED_HOSTS=localhost,127.0.0.1,SEU_IP_OU_DOMINIO_VPS
CSRF_TRUSTED_ORIGINS=http://localhost,http://SEU_IP_OU_DOMINIO_VPS,https://SEU_IP_OU_DOMINIO_VPS

# Banco de Dados PostgreSQL (Rede interna do Docker)
DB_NAME=fcn_staging_db
DB_USER=fcn_staging_admin
DB_PASS=crie_uma_senha_forte_para_o_staging_aqui

# Performance / Gunicorn
GUNICORN_WORKERS=3
HTTP_PORT=80
HTTPS_PORT=443

# Seguranca e SSL (1 = ativado em staging/producao)
USE_HTTPS=1
