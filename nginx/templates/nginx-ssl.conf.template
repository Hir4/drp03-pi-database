upstream django_backend {
    server backend:8000;
}

limit_req_zone $binary_remote_addr zone=req_limit:10m rate=15r/s;

# 1. Redirecionamento obrigatorio de HTTP para HTTPS
server {
    listen 80;
    server_name _;

    # Desafio ACME para renovacao automatica do Let's Encrypt
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    # Redireciona todas as demais requisicoes para HTTPS
    location / {
        return 301 https://$host$request_uri;
    }
}

# 2. Servidor Seguro HTTPS com TLS moderno
server {
    listen 443 ssl;
    http2 on;
    server_name _;
    client_max_body_size 10M;

    # Certificados SSL emitidos pelo Let's Encrypt
    ssl_certificate /etc/letsencrypt/live/${SSL_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${SSL_DOMAIN}/privkey.pem;

    # Protocolos e Ciphers modernos e recomendados (A+ SSL Labs)
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_timeout 1d;
    ssl_session_cache shared:SSL:10m;
    ssl_session_tickets off;

    # Cabecalhos Avancados de Seguranca
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options SAMEORIGIN always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # Compressao Gzip
    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_types
        text/plain
        text/css
        text/javascript
        application/javascript
        application/json
        application/x-javascript
        image/svg+xml;

    # Arquivos Estaticos coletados via collectstatic
    location /static/ {
        alias /var/www/staticfiles/;
        expires 30d;
        access_log off;
        add_header Cache-Control "public, max-age=2592000, immutable";
    }

    # Proxy reverso para o Gunicorn / Django com cabecalhos HTTPS
    location / {
        limit_req zone=req_limit burst=30 nodelay;

        proxy_pass http://django_backend;
        proxy_http_version 1.1;

        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Port 443;

        proxy_connect_timeout 60s;
        proxy_read_timeout 60s;
    }
}
